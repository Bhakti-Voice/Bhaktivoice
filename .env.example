# Site
NEXT_PUBLIC_SITE_URL=https://www.bhaktivoice.com

# Google Analytics 4 (Vercel Production env)
# Reports → Engagement → Pages and screens, and Reports → Realtime
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Also accepted: NEXT_PUBLIC_GA_ID or GA_MEASUREMENT_ID

# FastAPI CMS (public site reads content from here)
# Local: http://127.0.0.1:8000
# Vercel: do not set this — the frontend→backend service binding injects it.
CMS_API_URL=http://127.0.0.1:8000

# FastAPI (set these on the Vercel backend / project env)
SITE_ORIGIN=https://www.bhaktivoice.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# Firebase (Google login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Turso (used by FastAPI)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
